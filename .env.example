# Copy this file to .env.local and fill in your Supabase project values.
# Find these under Supabase Dashboard -> Project Settings -> API.
# Only the anon/public key goes here. NEVER put the service_role key
# or database password in this file or anywhere in frontend code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
